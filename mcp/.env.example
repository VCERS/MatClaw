MP_API_KEY=""
MOLPORT_API_KEY=""
HF_TOKEN="" # optional, only if you want faster downloads and higher rate limits

# --- DFT tools (optional; override config.yaml / defaults) ---
# MATCLAW_DFT_CONFIG=""        # path to a dft config.yaml (else auto-discovered)
# MATCLAW_DFT_WORKDIR=""       # root for job working dirs + default sqlite DB
# MATCLAW_DFT_DATABASE_URL=""  # e.g. postgresql+psycopg://user:pw@host/db (sqlite by default)
# MATCLAW_DFT_SCHEDULER=""     # "slurm" (default) or "local"
# MATCLAW_DFT_ACCOUNT=""       # SLURM account
# MATCLAW_DFT_PARTITION=""     # SLURM partition
# MATCLAW_DFT_QOS=""           # SLURM QoS
# MATCLAW_DFT_VASP_PP_PATH=""  # VASP pseudopotential dir (POTCAR generation)
# MATCLAW_DFT_ORCA_BIN=""      # directory containing the orca / orca_plot binaries